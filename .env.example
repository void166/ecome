# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Postgres connection string (Neon via Vercel Marketplace, Supabase, ...). Leave empty locally
# to use the embedded PGlite database in .data/ (dev only; production requires this).
DATABASE_URL=

# demo = no real payment (local/preview only, refused in production) · qpay = QPay merchant API v2
PAYMENT_PROVIDER=demo
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_RECEIVER_CODE=terminal

# Public HTTPS origin used for the QPay callback URL, e.g. https://void01.mn
PUBLIC_SITE_URL=
# Random string, 32+ characters: signs QPay callback URLs.
CALLBACK_SECRET=

# Delivery fee added to every order, in MNT. 0 = free delivery.
DELIVERY_FEE_MNT=0
# Minutes an unpaid order keeps its stock reserved.
ORDER_TTL_MINUTES=30

# Random string, 16+ characters: Bearer token for GET /api/admin-orders.
ADMIN_TOKEN=

# Ad pixels (public IDs, safe in the browser bundle). Loaded only after the visitor accepts cookies.
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
